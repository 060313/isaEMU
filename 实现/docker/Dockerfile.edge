# ============================================================================
# 边缘容器 —— nginx：托管前端静态资源 + TLS 终止 + 反向代理 /api 与 /ws
#
# 设计依据：《软件体系结构设计文档》
#   6.1 制品清单 —— 前端静态资源包（SS-7 的 dist/）由 nginx 托管
#   6.2 云端形态 —— 三容器之「边缘容器」，**唯一向宿主机发布 443**
#   6.5 节点间通信 —— 浏览器 ↔ 边缘容器 HTTPS/WSS(443)；
#                      边缘容器 ↔ 应用容器 走容器网络内 HTTP 的 /api 与 /ws
#   5.3.2 选定资源 —— nginx / BSD-2-Clause
#
# 构建上下文 = 实现/
# ============================================================================

# ---------------------------------------------------------------- 阶段 1：构建前端
FROM node:22-bookworm-slim AS web

WORKDIR /web
COPY frontend/package.json ./
# 仓库未提交 package-lock.json，故用 npm install；补上锁文件后可改 npm ci 以保证可重现
RUN npm install --no-audit --no-fund

COPY frontend/tsconfig.json frontend/index.html ./
COPY frontend/src ./src
# tsc 只编译 .ts，不会搬 index.html；把它一并放进 dist/，
# 使 dist/ 成为自包含的「前端静态资源包」（SAD 6.1）
RUN npx tsc -p tsconfig.json && cp index.html dist/index.html

# ---------------------------------------------------------------- 阶段 2：nginx 托管
FROM nginx:1.27-alpine

LABEL org.opencontainers.image.title="isa-sim edge" \
      org.opencontainers.image.description="ISA 模拟系统 —— 边缘容器（nginx + 前端静态资源）"

RUN rm -f /etc/nginx/conf.d/default.conf

# 自签名证书，仅供开发 / 演示与首次联调。
# 生产环境须替换为正式证书（挂载 /etc/nginx/certs，或由上游负载均衡终止 TLS）。
RUN apk add --no-cache openssl \
    && mkdir -p /etc/nginx/certs \
    && openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
         -subj "/CN=isa-sim.local" \
         -keyout /etc/nginx/certs/server.key \
         -out /etc/nginx/certs/server.crt \
    && chmod 600 /etc/nginx/certs/server.key

COPY docker/nginx.conf /etc/nginx/conf.d/isa.conf
COPY --from=web /web/dist /usr/share/nginx/html

# 唯一向宿主机发布的端口（SAD 6.2）
EXPOSE 443
