# ============================================================================
# Docker 构建上下文排除规则（构建上下文 = 实现/）
#
# 目的：镜像里只需要源码、构建脚本与 DDL；构建产物、依赖与本机私有文件一律不进上下文。
# 注意：docker/Dockerfile.* 与 docker/nginx.conf 必须保留，勿排除 docker/。
# ============================================================================

# ---- 版本控制与文档 ----
.git
.gitignore
**/*.md

# ---- 后端构建产物 ----
build/
**/*.o
**/*.obj
**/*.a
**/*.lib
**/*.exe
**/*.pdb
CMakeCache.txt
CMakeFiles/
cmake-build-*/

# ---- 前端产物与依赖（镜像内会重新构建）----
frontend/node_modules/
frontend/dist/
**/*.tsbuildinfo

# ---- Python 生成器的缓存 ----
**/__pycache__/
**/*.py[cod]

# ---- 本机私有配置与数据库文件 ----
.env
.env.*
!.env.example
config.toml
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---- 其它 ----
_selfcheck/
*.log
*.tmp
