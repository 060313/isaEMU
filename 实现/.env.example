# ============================================================================
# 云端形态（docker-compose.yml）的环境变量示例
#
# 用法：复制为 .env 后填入真实值。
#        .env 已被 .gitignore 忽略，不会入库。
#
# 设计依据：《软件体系结构设计文档》6.1（云端配置：容器环境变量 + 挂载配置）、
#           6.6（双形态对等——云端与本地是同一套代码，形态只由配置项区分）
# ============================================================================

# ---- 数据容器（PostgreSQL）------------------------------------------------
POSTGRES_DB=isa_sim
POSTGRES_USER=isa_sim
# 必填：留空则 docker compose 直接报错退出，避免弱口令被带上线
POSTGRES_PASSWORD=

# ---- 边缘容器 --------------------------------------------------------------
# 向宿主机发布的 HTTPS 端口；443 需要管理员/root 权限，联调时可改成 8443
HTTPS_PORT=443

# ---- 应用容器 --------------------------------------------------------------
# 置 1 则在构建应用镜像时从源码编译 Spike 1.1.0（参考模拟器，耗时较长）
WITH_SPIKE=0
